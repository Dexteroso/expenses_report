# Copy this file to .env if you want to override docker-compose defaults.
# Do not commit real production secrets.

MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=expenses_report
MYSQL_USER=expenses_user
MYSQL_PASSWORD=expenses_password

JWT_SECRET=change_me_for_local_docker
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# Optional for local Docker email testing. Required in production when password reset email is enabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Expenses Report <no-reply@example.com>"

